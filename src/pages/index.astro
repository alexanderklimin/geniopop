---
// Root: language picker (x-default). No automatic redirect by IP or Accept-Language: it confuses Googlebot.
import { LIVE, LANG_NAMES, t } from '../i18n/ui.js';
import { SITE_NAME } from '../data/site.js';
const absolute = (p: string) => new URL(p, Astro.site).href;
const description = 'Matemáticas paso a paso · Mathe mit Rechenweg · Matematica passo dopo passo';
---
<!doctype html>
<html lang="mul">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME}: matemáticas · Mathe · matematica</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute('/')} />
    {LIVE.map((l) => <link rel="alternate" hreflang={l} href={absolute(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ff6b35" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; background: #fffaf5; color: #1d2433; }
      main { text-align: center; padding: 2rem 1rem; }
      .brand { font-size: clamp(2.4rem, 9vw, 3.6rem); font-weight: 800; margin: 0 0 0.5rem; letter-spacing: -0.02em; }
      .brand span { color: #ff6b35; }
      p { color: #5a6475; margin: 0 0 2rem; }
      ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; min-width: min(20rem, 90vw); }
      a { display: block; padding: 1rem 1.25rem; border-radius: 16px; background: #fff; border: 2px solid #f0e2d6; color: #1d2433; text-decoration: none; font-weight: 700; font-size: 1.15rem; }
      a:hover, a:focus-visible { border-color: #ff6b35; }
      small { display: block; font-weight: 400; color: #5a6475; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <main>
      <h1 class="brand">Genio<span>Pop</span></h1>
      <p>{description}</p>
      <ul>
        {LIVE.map((l) => <li><a href={`/${l}/`} hreflang={l} lang={l}>{LANG_NAMES[l]}<small>{t(l).home_h1}</small></a></li>)}
      </ul>
    </main>
  </body>
</html>
