---
// Root: language picker (x-default). No automatic redirect by IP or Accept-Language: it confuses Googlebot.
import { LIVE, LANG_NAMES, t } from '../i18n/ui.js';
import { SITE_NAME } from '../data/site.js';
import '@fontsource-variable/nunito/wght.css';
import '../styles/global.css';
const absolute = (p: string) => new URL(p, Astro.site).href;
const description = 'Matemáticas paso a paso · Mathe mit Rechenweg · Matematica passo dopo passo';
---
<!doctype html>
<html lang="mul">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME}: matemáticas · Mathe · matematica</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absolute('/')} />
    {LIVE.map((l) => <link rel="alternate" hreflang={l} href={absolute(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ff6b35" />
    <style>
      body { display: grid; place-items: center; }
      main { text-align: center; padding: 2rem 1rem; }
      .brand-word { font-size: clamp(3rem, 12vw, 5rem); font-weight: 900; margin: 0 0 0.5rem; letter-spacing: -0.03em; text-decoration: none; }
      .brand-word span { color: #ff6b35; }
      p { color: #5b6180; margin: 0 0 2rem; font-weight: 700; }
      ul { list-style: none; padding: 0; margin: 0 auto; display: grid; gap: 1rem; width: min(24rem, 90vw); }
      li:nth-child(1) a { box-shadow: 6px 6px 0 #7c5cff; }
      li:nth-child(2) a { box-shadow: 6px 6px 0 #00a99d; }
      li:nth-child(3) a { box-shadow: 6px 6px 0 #ffb020; }
      a.lang { display: block; padding: 1.1rem 1.3rem; border-radius: 22px; background: #fff; border: 2px solid #1b1f3b; color: #1b1f3b; text-decoration: none; font-weight: 900; font-size: 1.35rem; transition: transform 0.12s; }
      a.lang:hover, a.lang:focus-visible { transform: translate(-2px, -2px); }
      small { display: block; font-weight: 700; color: #5b6180; font-size: 0.95rem; }
    </style>
  </head>
  <body>
    <main>
      <h1 class="brand-word">Genio<span>Pop</span></h1>
      <p>{description}</p>
      <ul>
        {LIVE.map((l) => <li><a class="lang" href={`/${l}/`} hreflang={l} lang={l}>{LANG_NAMES[l]}<small>{t(l).home_h1}</small></a></li>)}
      </ul>
    </main>
  </body>
</html>
