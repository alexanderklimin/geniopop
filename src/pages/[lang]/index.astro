---
import Base from '../../layouts/Base.astro';
import { LIVE, t } from '../../i18n/ui.js';

export function getStaticPaths() {
  return LIVE.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const ui = t(lang);
const alternates = Object.fromEntries(LIVE.map((l) => [l, `/${l}/`]));
---
<Base lang={lang} title={ui.home_title} description={ui.home_description} alternates={alternates}>
  <h1>{ui.home_h1}</h1>
  <p class="lead">{ui.home_lead}</p>
  <ul class="cards">
    {ui.sections.map((s) => (
      <li class="card">
        <h2>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h2>
        <p>{s.text}</p>
        {s.links && <p class="card-links">{s.links.map(([t, h]) => <a href={h}>{t}</a>)}</p>}
        {!s.href && !s.links && <span class="tag">{ui.soon}</span>}
      </li>
    ))}
  </ul>
</Base>
<style>
  .card-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 0.6rem !important; }
  .card-links a { font-weight: 700; }
</style>
