---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { LIVE, t } from '../../i18n/ui.js';
import { HOME } from '../../data/home.js';
import { AUTHOR, authorPath } from '../../data/author.js';
import { COURSES } from '../../data/es/fichas.js';
import { LEGAL, legalPath } from '../../data/legal.js';

export function getStaticPaths() {
  return LIVE.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };
const ui = t(lang);
const H = HOME[lang];
const alternates = Object.fromEntries(LIVE.map((l) => [l, `/${l}/`]));
const site = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'GenioPop', url: new URL(`/${lang}/`, Astro.site).href, inLanguage: lang };
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: H.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base lang={lang} title={ui.home_title} description={ui.home_description} alternates={alternates} jsonLd={[site, faq]}>
  <section class="hero">
    <div class="hero-text">
      <p class="kicker">{ui.kicker}</p>
      <h1>{H.h1}</h1>
      <p class="lead">{H.lead}</p>
      <ul class="trust">{ui.trust.map(([icon, text]) => <li><Icon name={icon} size={20} /> {text}</li>)}</ul>
    </div>
    <form class="demo" data-demo data-ok={H.demo.ok} data-bad={H.demo.bad} data-answer={H.demo.q[0] * H.demo.q[1]}>
      <p class="demo-title">{H.demo.title}</p>
      <div class="demo-q"><span>{H.demo.q[0]} × {H.demo.q[1]} =</span><input name="x" inputmode="numeric" maxlength="3" placeholder={H.demo.placeholder} aria-label={`${H.demo.q[0]} × ${H.demo.q[1]}`} /></div>
      <button class="button primary">{H.demo.check}</button>
      <p class="demo-msg" data-msg aria-live="polite"></p>
      <a class="demo-more" href="/es/tablas-de-multiplicar/">{H.demo.more} <Icon name="arrow" size={18} /></a>
    </form>
  </section>

  <h2>{H.toolsTitle}</h2>
  <ul class="tools">
    {H.tools.map((x) => (
      <li style={`--c: var(--c-${x.c})`}><a href={x.href}><span class="ti"><Icon name={x.icon} size={26} /></span><strong>{x.title}</strong><span class="tt">{x.text}</span></a></li>
    ))}
  </ul>

  <h2>{H.tablesTitle}</h2>
  <div class="tnums">
    {Array.from({ length: 12 }, (_, i) => i + 1).map((n) => <a href={H.tablesHref(n)} style={`--h:${(n * 37 + 250) % 360}`}><small>×</small>{n}</a>)}
    {H.tablesExtra.map(([l, h]) => <a class="wide" href={h}>{l}</a>)}
  </div>

  <h2>{H.groupsTitle}</h2>
  <div class="groups">
    {H.groups.map((g) => (
      <section class="grp" style={`--c: var(--c-${g.c})`}>
        <h3><span class="ti"><Icon name={g.icon} size={22} /></span>{g.title}</h3>
        <ul>{g.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </section>
    ))}
  </div>

  <h2>{H.coursesTitle}</h2>
  <ul class="courses">
    {COURSES.map((c) => <li><a href={`/es/fichas/${c.slug}/`}><strong>{c.name}</strong><span>{c.syn}</span></a></li>)}
  </ul>

  <h2>{H.steps.title}</h2>
  <ol class="steps">{H.steps.items.map(([h, p]) => <li><strong>{h}</strong><span>{p}</span></li>)}</ol>

  <a class="reviewer" href={authorPath(lang)}>
    <img src={AUTHOR.photo} alt="" width="72" height="72" loading="lazy" />
    <span><small>{ui.reviewedBy}</small><strong>{AUTHOR.name}</strong>, {ui.reviewer}</span>
  </a>

  <section class="prose">
    <dl class="faq">{H.faq.map((f) => <><dt>{f.q}</dt><dd>{f.a}</dd></>)}</dl>
    <p class="more-legal"><a href={legalPath(lang, 'privacy')}>{LEGAL[lang].names.privacy}</a></p>
  </section>
</Base>

<script>
  const f = document.querySelector('[data-demo]');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ok = Number(f.elements.x.value) === Number(f.dataset.answer);
    const msg = f.querySelector('[data-msg]');
    msg.textContent = ok ? f.dataset.ok : f.dataset.bad;
    msg.className = `demo-msg ${ok ? 'ok' : 'bad'}`;
    f.classList.remove('pop', 'shake'); void f.offsetWidth; f.classList.add(ok ? 'pop' : 'shake');
  });
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: center; padding-top: 0.5rem; }
  .kicker { display: inline-block; margin: 0 0 0.8rem; padding: 0.3rem 0.85rem; border-radius: 999px; background: #fff; border: 2px solid var(--ink); font-weight: 900; font-size: 0.82rem; box-shadow: 3px 3px 0 var(--c-fichas); }
  .hero h1 { font-size: clamp(2.1rem, 5.4vw, 3.3rem); max-width: 16ch; }
  .trust { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .trust li { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .trust svg { color: var(--pop); flex-shrink: 0; }
  .demo { background: #fff; border: 2px solid var(--ink); border-radius: var(--radius); padding: 1.3rem; box-shadow: 7px 7px 0 var(--c-tablas); display: grid; gap: 0.8rem; justify-items: center; text-align: center; }
  .demo-title { margin: 0; font-weight: 900; color: var(--c-tablas); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; }
  .demo-q { display: flex; align-items: center; gap: 0.6rem; font-size: clamp(2.2rem, 7vw, 3rem); font-weight: 900; background: #efeaff; border-radius: 18px; padding: 0.6rem 1rem; }
  .demo-q input { width: 3.2ch; font: inherit; text-align: center; color: var(--c-tablas); border: 3px solid var(--ink); border-radius: 14px; background: #fff; }
  .demo-q input:focus { outline: none; box-shadow: 0 0 0 4px var(--c-tablas); }
  .demo .button.primary { background: var(--c-tablas); }
  .demo-msg { margin: 0; min-height: 1.5em; font-weight: 900; }
  .demo-msg.ok { color: #13863f; } .demo-msg.bad { color: #c2261b; }
  .demo-more { font-weight: 900; color: var(--c-tablas); text-decoration: none; display: inline-flex; gap: 0.3rem; align-items: center; }
  .demo.pop { animation: pop 0.35s; } .demo.shake { animation: shake 0.4s; }
  @keyframes pop { 40% { transform: scale(1.03); } }
  @keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }

  .tools { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: 0.9rem; }
  .tools a { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 0.8rem; align-items: center; padding: 0.9rem 1rem; border-radius: 18px; background: #fff; border: 2px solid var(--ink); box-shadow: 4px 4px 0 var(--c); color: var(--ink); text-decoration: none; transition: transform 0.12s, box-shadow 0.12s; height: 100%; }
  .tools a:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--c); }
  .tools .ti { grid-row: 1 / 3; }
  .ti { display: inline-grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 14px; background: var(--c); color: #fff; flex-shrink: 0; }
  .tools strong { font-size: 1.05rem; line-height: 1.2; }
  .tt { color: var(--muted); font-size: 0.9rem; line-height: 1.3; }

  .tnums { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tnums a { --tc: hsl(var(--h) 75% 55%); display: inline-flex; align-items: baseline; gap: 0.1rem; min-width: 3.6rem; justify-content: center; padding: 0.55rem 0.8rem; border-radius: 14px; background: var(--tc); color: #fff; font-weight: 900; font-size: 1.35rem; text-decoration: none; box-shadow: 0 3px 0 hsl(var(--h) 70% 38%); transition: transform 0.1s; }
  .tnums a small { font-size: 0.7em; opacity: 0.85; }
  .tnums a:hover { transform: translateY(-2px); }
  .tnums a.wide { background: #fff; color: var(--ink); border: 2px solid var(--ink); box-shadow: 0 3px 0 var(--ink); font-size: 1rem; }

  .groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; }
  .grp { background: #fff; border: 2px solid var(--line); border-radius: var(--radius); padding: 1rem 1.2rem; border-top: 6px solid var(--c); }
  .grp h3 { display: flex; align-items: center; gap: 0.6rem; margin: 0 0 0.6rem; font-size: 1.2rem; }
  .grp .ti { width: 2.3rem; height: 2.3rem; border-radius: 11px; }
  .grp ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
  .grp a { color: var(--ink); font-weight: 700; text-decoration-color: var(--c); text-decoration-thickness: 2px; }

  .courses { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.7rem; }
  .courses a { display: flex; flex-direction: column; padding: 0.8rem 1rem; border-radius: 16px; background: #fff; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--c-fichas); color: var(--ink); text-decoration: none; }
  .courses strong { font-weight: 900; } .courses span { color: var(--muted); font-size: 0.85rem; font-weight: 700; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; counter-reset: st; }
  .steps li { position: relative; background: #fff; border: 2px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.1rem 1.1rem 3.8rem; display: grid; }
  .steps li::before { counter-increment: st; content: counter(st); position: absolute; left: 1rem; top: 1rem; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--pop); color: #fff; display: grid; place-items: center; font-weight: 900; }
  .steps span { color: var(--muted); }

  .reviewer { display: flex; align-items: center; gap: 1rem; margin: 2.5rem 0 1rem; padding: 1rem 1.2rem; border-radius: var(--radius); background: #fff; border: 2px solid var(--line); color: var(--ink); text-decoration: none; max-width: 40rem; }
  .reviewer img { border-radius: 50%; object-fit: cover; border: 3px solid var(--c-fichas); }
  .reviewer small { display: block; color: var(--muted); font-weight: 700; }
  .more-legal { font-size: 0.9rem; }
  @media (max-width: 800px) { .hero { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
