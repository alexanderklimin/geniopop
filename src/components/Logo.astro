---
// GenioPop logo: tilted orange tile with a light bulb and sparks + "Genio" (ink) "Pop" (section colors, bouncy).
interface Props { dark?: boolean; size?: number }
const { dark = false, size = 38 } = Astro.props;
---
<span class:list={['logo', { dark }]}>
  <svg class="logo-mark" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true">
    <g class="spark"><path d="M40 4.5v5M44.5 9h-5M41.8 6.2l-2.4 2.4" stroke="#ffb020" stroke-width="3" stroke-linecap="round" /></g>
    <rect x="5" y="7" width="34" height="34" rx="10" fill="#ff6b35" stroke="#1b1f3b" stroke-width="2.5" transform="rotate(-8 22 24)" />
    <path d="M17 21.5a5.5 5.5 0 1 1 8.8 4.4c-.7.5-1.1 1.3-1.1 2.2v1.2h-4.4v-1.2c0-.9-.4-1.7-1.1-2.2a5.5 5.5 0 0 1-2.2-4.4z" fill="#fff" transform="rotate(-8 22 24)" />
    <rect x="19.8" y="31" width="4.4" height="2.4" rx="1.2" fill="#fff" transform="rotate(-8 22 24)" />
    <circle cx="7" cy="42" r="2.6" fill="#7c5cff" />
  </svg>
  <span class="logo-word">Genio<span class="pop"><b>P</b><b>o</b><b>p</b></span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.45rem; }
  .logo-mark { flex-shrink: 0; transition: transform 0.3s; overflow: visible; }
  .logo-word { font-weight: 900; font-size: 1.5rem; letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
  .dark .logo-word { color: #fff; }
  .pop { display: inline-flex; margin-left: 0.04em; }
  .pop b { display: inline-block; font-weight: 900; transition: transform 0.2s; }
  .pop b:nth-child(1) { color: #7c5cff; transform: rotate(-6deg) translateY(1px); }
  .pop b:nth-child(2) { color: #00a99d; transform: rotate(5deg) translateY(-2px); }
  .pop b:nth-child(3) { color: #ff4f9a; transform: rotate(-4deg) translateY(1px); }
  :global(a:hover) > .logo .logo-mark, .logo:hover .logo-mark { transform: rotate(-8deg) scale(1.06); }
  :global(a:hover) > .logo .pop b, .logo:hover .pop b { animation: hop 0.45s ease-out; }
  .pop b:nth-child(2) { animation-delay: 0.07s !important; }
  .pop b:nth-child(3) { animation-delay: 0.14s !important; }
  @keyframes hop { 40% { translate: 0 -6px; } }
</style>
