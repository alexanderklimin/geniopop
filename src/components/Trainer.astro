---
// Multiplication trainer (island, vanilla JS). Progress only in localStorage, nothing is sent anywhere.
import { TRAINER } from '../i18n/trainer.js';

interface Props { lang: string; tables?: number[]; fixed?: boolean; mul?: string }
const { lang, tables = [2, 3, 4, 5, 6, 7, 8, 9], fixed = false, mul = '×' } = Astro.props;
const t = TRAINER[lang];
const choices = Array.from({ length: 12 }, (_, i) => i + 1);
---
<section class="trainer" data-trainer data-lang={lang} data-mul={mul} data-fixed={fixed ? '1' : undefined} data-tables={JSON.stringify(tables)} data-t={JSON.stringify(t)} aria-label={t.title}>
  <div class="tr-setup" data-setup>
    {!fixed && (
      <fieldset class="tr-tables">
        <legend>{t.pick}</legend>
        <div class="tr-chips">
          {choices.map((n) => (
            <label class="chip"><input type="checkbox" value={n} checked={tables.includes(n)} /><span>{n}</span></label>
          ))}
        </div>
      </fieldset>
    )}
    <div class="tr-modes" role="radiogroup">
      {Object.entries(t.modes).map(([k, label], i) => (
        <label class="mode"><input type="radio" name={`mode-${fixed ? tables[0] : 'all'}`} value={k} checked={i === (fixed ? 0 : 1)} /><span>{label}</span></label>
      ))}
    </div>
    <button type="button" class="btn btn-main" data-start>{t.start}</button>
    <p class="tr-msg" data-msg aria-live="polite"></p>
  </div>

  <div class="tr-stage" data-stage hidden>
    <div class="tr-top"><span data-progress></span><span data-timer></span></div>
    <div class="tr-bar" aria-hidden="true"><i data-bar></i></div>
    <form class="tr-q" data-form autocomplete="off">
      <label class="tr-question" for={`ans-${fixed ? tables[0] : 'all'}`} data-question></label>
      <input id={`ans-${fixed ? tables[0] : 'all'}`} class="tr-input" data-input inputmode="numeric" pattern="[0-9]*" maxlength="3" aria-label={t.answer} />
      <button class="btn btn-main" data-check>{t.check}</button>
    </form>
    <p class="tr-feedback" data-feedback aria-live="assertive"></p>
    <button type="button" class="btn btn-ghost" data-stop>{t.stop}</button>
  </div>

  <div class="tr-result" data-result hidden>
    <p class="tr-stars" data-stars aria-hidden="true"></p>
    <p class="tr-score" data-score></p>
    <div data-review></div>
    <button type="button" class="btn btn-main" data-again>{t.again}</button>
  </div>

  <p class="tr-note"><span data-mastered></span> {t.privacy} <button type="button" class="link" data-reset>{t.reset}</button></p>
</section>

<script>
  import { questions, recordAnswer, pickWeighted, mastered, factKey } from '../lib/tables.js';
  import { createRng } from '../lib/rng.js';

  const KEY = 'gp_tables_v1';
  const load = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
  const save = (s) => { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {} };

  for (const root of document.querySelectorAll('[data-trainer]')) {
    const t = JSON.parse(root.dataset.t);
    const mul = root.dataset.mul;
    const $ = (s) => root.querySelector(s);
    const setup = $('[data-setup]'), stage = $('[data-stage]'), result = $('[data-result]');
    const input = $('[data-input]'), feedback = $('[data-feedback]');
    let stats = load();
    let queue = [], current = null, done = 0, right = 0, mistakes = [], mode = 'shuffle', endAt = 0, timerId = 0, pool = [], waiting = false, shownAt = 0;
    const rng = createRng(Date.now());

    const selected = () => root.dataset.fixed ? JSON.parse(root.dataset.tables)
      : [...root.querySelectorAll('.tr-tables input:checked')].map((i) => Number(i.value));

    function showMastered() {
      const tabs = selected();
      const facts = tabs.flatMap((a) => Array.from({ length: 10 }, (_, i) => factKey(Math.min(a, i + 1), Math.max(a, i + 1))));
      const uniq = [...new Set(facts)];
      $('[data-mastered]').textContent = uniq.length ? `${t.mastered}: ${uniq.filter((k) => mastered(stats[k])).length} ${t.of} ${uniq.length}.` : '';
    }

    function ask() {
      if (mode === 'timed') current = pickWeighted(pool, stats, rng);
      else current = queue[done];
      $('[data-question]').textContent = `${current.a} ${mul} ${current.b} =`;
      $('[data-progress]').textContent = mode === 'timed' ? `${t.score}: ${right}` : `${done + 1} ${t.of} ${queue.length}`;
      if (mode !== 'timed') $('[data-bar]').style.width = `${(done / queue.length) * 100}%`;
      input.value = '';
      feedback.textContent = '';
      feedback.className = 'tr-feedback';
      waiting = false;
      shownAt = performance.now();
      input.focus();
    }

    function start() {
      const tabs = selected();
      if (!tabs.length) { $('[data-msg]').textContent = t.pickOne; return; }
      $('[data-msg]').textContent = '';
      mode = root.querySelector('.tr-modes input:checked').value;
      done = 0; right = 0; mistakes = [];
      $('[data-timer]').textContent = '';
      if (mode === 'order') queue = questions(tabs, { mode: 'order', from: 1, to: 10 });
      else if (mode === 'shuffle') {
        const all = questions(tabs, { mode: 'mixed', from: 1, to: 10, seed: rng.int(1, 1e9) });
        // weak facts first when there are many: keep 20, weighted
        queue = all.length <= 20 ? all : [...all].sort((x, y) => weightOf(y) - weightOf(x) || rng.next() - 0.5).slice(0, 20).sort(() => rng.next() - 0.5);
      } else {
        pool = questions(tabs, { mode: 'mixed', from: 1, to: 10, seed: rng.int(1, 1e9) });
        endAt = performance.now() + 60000;
        tick();
        timerId = setInterval(tick, 250);
      }
      setup.hidden = true; result.hidden = true; stage.hidden = false;
      ask();
    }

    const weightOf = (q) => { const s = stats[q.key]; return s ? s.wrong * 2 - s.right : 1; };

    function tick() {
      const left = Math.max(0, Math.ceil((endAt - performance.now()) / 1000));
      $('[data-timer]').textContent = `${t.time}: ${left} s`;
      $('[data-bar]').style.width = `${100 - ((endAt - performance.now()) / 60000) * 100}%`;
      if (left <= 0) finish();
    }

    function finish() {
      clearInterval(timerId);
      stage.hidden = true; result.hidden = false;
      const total = mode === 'timed' ? right + mistakes.length : queue.length;
      $('[data-score]').textContent = `${t.score}: ${right} ${t.of} ${total}`;
      const ratio = total ? right / total : 0;
      const stars = mode === 'timed' ? (right >= 25 ? 3 : right >= 15 ? 2 : right >= 5 ? 1 : 0) : (ratio === 1 ? 3 : ratio >= 0.8 ? 2 : ratio >= 0.5 ? 1 : 0);
      $('[data-stars]').innerHTML = [0, 1, 2].map((i) => `<span class="${i < stars ? 'on' : ''}">★</span>`).join('');
      const box = $('[data-review]');
      box.textContent = '';
      const uniq = [...new Map(mistakes.map((q) => [q.key, q])).values()];
      if (uniq.length) {
        const h = document.createElement('p'); h.textContent = `${t.review}:`; box.append(h);
        const ul = document.createElement('ul'); ul.className = 'tr-list';
        for (const q of uniq) { const li = document.createElement('li'); li.textContent = `${q.a} ${mul} ${q.b} = ${q.answer}`; ul.append(li); }
        box.append(ul);
      } else if (total > 0) {
        const p = document.createElement('p'); p.textContent = t.perfect; box.append(p);
      }
      showMastered();
      $('[data-again]').focus();
    }

    $('[data-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      if (waiting) return;
      const value = input.value.trim();
      if (value === '') { input.focus(); return; }
      const ok = Number(value) === current.answer;
      stats = recordAnswer(stats, current.key, ok, performance.now() - shownAt);
      save(stats);
      const card = $('[data-form]');
      card.classList.remove('pop', 'shake'); void card.offsetWidth;
      if (ok) { right++; feedback.textContent = t.right[rng.int(0, t.right.length - 1)]; feedback.className = 'tr-feedback ok'; card.classList.add('pop'); }
      else { mistakes.push(current); feedback.textContent = `${t.wrong} ${current.a} ${mul} ${current.b} = ${current.answer}`; feedback.className = 'tr-feedback bad'; card.classList.add('shake'); }
      waiting = true;
      done++;
      const delay = ok ? 600 : 1800;
      setTimeout(() => {
        if (mode === 'timed') { if (performance.now() < endAt) ask(); }
        else if (done >= queue.length) finish();
        else ask();
      }, delay);
    });

    $('[data-start]').addEventListener('click', start);
    $('[data-again]').addEventListener('click', () => { result.hidden = true; setup.hidden = false; });
    $('[data-stop]').addEventListener('click', () => { if (mode !== 'timed') queue = queue.slice(0, done); finish(); });
    $('[data-reset]').addEventListener('click', () => { stats = {}; save(stats); showMastered(); });
    root.querySelectorAll('.tr-tables input').forEach((i) => i.addEventListener('change', showMastered));
    showMastered();
  }
</script>

<style>
  .trainer { background: var(--card); border: 2px solid var(--ink); border-radius: var(--radius); padding: 1.4rem 1.3rem; margin: 1.5rem 0; box-shadow: 6px 6px 0 var(--accent); }
  .trainer fieldset { border: 0; padding: 0; margin: 0 0 1rem; }
  .trainer legend { font-weight: 900; margin-bottom: 0.6rem; }
  .tr-chips, .tr-modes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
  .chip input, .mode input { position: absolute; opacity: 0; }
  .chip span, .mode span { display: inline-flex; align-items: center; justify-content: center; min-width: 2.9rem; min-height: 2.9rem; padding: 0 0.9rem; border-radius: 14px; border: 2px solid var(--line); background: #fff; font-weight: 900; font-size: 1.05rem; cursor: pointer; transition: transform 0.1s; }
  .chip span:hover, .mode span:hover { transform: translateY(-2px); border-color: var(--accent); }
  .chip input:checked + span, .mode input:checked + span { background: var(--accent); border-color: var(--accent-dark); color: #fff; box-shadow: 0 3px 0 var(--accent-dark); }
  .chip input:focus-visible + span, .mode input:focus-visible + span { outline: 3px solid var(--ink); }
  .btn-ghost { margin-top: 0.75rem; }
  .tr-top { display: flex; justify-content: space-between; color: var(--muted); font-weight: 800; }
  .tr-bar { height: 10px; border-radius: 999px; background: var(--accent-soft); overflow: hidden; margin: 0.5rem 0 0; }
  .tr-bar i { display: block; height: 100%; width: 0; background: var(--accent); border-radius: 999px; transition: width 0.3s; }
  .tr-q { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; margin: 1.25rem 0 1rem; padding: 1.2rem 0.5rem; border-radius: 18px; background: var(--accent-soft); }
  .tr-question { font-size: clamp(2.4rem, 11vw, 4rem); font-weight: 900; letter-spacing: -0.02em; }
  .tr-input { width: 3.2ch; font: inherit; font-size: clamp(2.4rem, 11vw, 4rem); font-weight: 900; text-align: center; color: var(--accent-dark); background: #fff; border: 3px solid var(--ink); border-radius: 16px; padding: 0 0.15em; }
  .tr-input:focus { outline: none; box-shadow: 0 0 0 4px var(--accent); }
  .tr-q.pop { animation: pop 0.35s ease-out; }
  .tr-q.shake { animation: shake 0.4s; }
  @keyframes pop { 40% { transform: scale(1.05); background: #d8f6e3; } }
  @keyframes shake { 20%, 60% { transform: translateX(-8px); } 40%, 80% { transform: translateX(8px); } }
  .tr-feedback { min-height: 1.6em; text-align: center; font-weight: 900; font-size: 1.25rem; margin: 0; }
  .tr-feedback.ok { color: #13863f; }
  .tr-feedback.bad { color: #c2261b; }
  .tr-stars { font-size: 2.6rem; margin: 0; letter-spacing: 0.1em; }
  .tr-stars span { color: var(--line); }
  .tr-stars span.on { color: var(--c-fichas); text-shadow: 0 2px 0 #c98200; }
  .tr-score { font-size: 1.7rem; font-weight: 900; margin: 0 0 0.5rem; }
  .tr-list { columns: 2; padding-left: 1.2rem; font-weight: 700; }
  .tr-msg { color: #c2261b; min-height: 1.2em; margin: 0.5rem 0 0; font-weight: 700; }
  .tr-note { font-size: 0.85rem; color: var(--muted); margin: 1rem 0 0; }
  @media print { .trainer { display: none; } }
</style>
