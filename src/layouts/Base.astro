---
import '@fontsource-variable/nunito/wght.css';
import Analytics from '../components/Analytics.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import '../styles/tools.css';
import { SITE_NAME } from '../data/site.js';
import { LANG_NAMES, OG_LOCALE, LIVE, NAV, sectionOf, t } from '../i18n/ui.js';
import { authorPath } from '../data/author.js';

interface Props {
  lang: string;               // 'es' | 'de' | 'it'
  title: string;
  description: string;
  alternates?: Record<string, string>; // hreflang → path of the same page in other languages
  xDefault?: string;          // path for hreflang x-default (the language picker)
  noindex?: boolean;
  crumbs?: { name: string; path: string }[]; // breadcrumb trail after the language home
  jsonLd?: Record<string, unknown>[];
  kidsPage?: boolean;         // child-directed page: ads only with TFAT (later); GA4 runs with Google signals/ad personalization off site-wide (CLAUDE.md allows this)
}

const { lang, title, description, alternates = {}, xDefault = '/', noindex = false, kidsPage = false, crumbs = [], jsonLd = [] } = Astro.props;
const ui = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;
const branded = `${title} | ${SITE_NAME}`;
const fullTitle = branded.length > 65 ? title : branded;
const home = `/${lang}/`;
const section = sectionOf(Astro.url.pathname);
const nav = NAV[lang] ?? [];
const current = Astro.url.pathname;
// hreflang only when the page really exists in more than one language
const multi = Object.keys(alternates).length > 1;
const switcher = LIVE.map((l) => [l, alternates[l] ?? `/${l}/`]);
const trail = crumbs.length ? [{ name: ui.home, path: home }, ...crumbs] : [];
const schemas = [...jsonLd];
if (trail.length) schemas.push({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: absolute(c.path) })),
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8f0" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {multi && Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={absolute(p)} />)}
    {multi && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
  </head>
  <body data-kids={kidsPage ? '1' : undefined} data-section={section}>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={home} aria-label={`${SITE_NAME}, ${ui.home}`}>
          <svg class="brand-mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="var(--pop)"/><path d="M13.5 17.5a6.5 6.5 0 1 1 10.4 5.2c-.8.6-1.4 1.5-1.4 2.5v1.3h-5V25c0-1-.6-1.9-1.4-2.5a6.5 6.5 0 0 1-2.6-5z" fill="#fff"/><rect x="17.2" y="28.6" width="5.6" height="2.6" rx="1.3" fill="#fff"/><circle cx="31" cy="9" r="3" fill="var(--c-fichas)"/><circle cx="8" cy="30" r="2.2" fill="var(--c-tablas)"/></svg>
          <span class="brand-word">Genio<span>Pop</span></span>
        </a>
        {nav.length > 0 && (
          <nav class="mainnav" aria-label={ui.menu}>
            {nav.map((n) => <a href={n.href} data-c={n.key} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        )}
        <nav class="langs" aria-label={ui.language}>
          {switcher.map(([l, p]) => (
            <a href={p} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      {section !== 'home' && (
        <svg class="deco" viewBox="0 0 220 140" aria-hidden="true">
          <text x="18" y="52" font-size="46" transform="rotate(-12 30 40)">×</text>
          <text x="96" y="40" font-size="34" transform="rotate(10 100 30)">÷</text>
          <text x="160" y="70" font-size="40" transform="rotate(-6 170 60)">%</text>
          <text x="60" y="112" font-size="30" transform="rotate(8 70 100)">½</text>
          <text x="140" y="128" font-size="36" transform="rotate(-14 150 118)">+</text>
          <circle cx="200" cy="20" r="6" /><circle cx="8" cy="100" r="4" />
        </svg>
      )}
      {trail.length > 0 && (
        <nav class="crumbs" aria-label="breadcrumb">
          {trail.map((c, i) => i < trail.length - 1 ? <><a href={c.path}>{c.name}</a><span aria-hidden="true"> › </span></> : <span aria-current="page">{c.name}</span>)}
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a class="brand" href={home}><span class="brand-word">Genio<span>Pop</span></span></a>
          <p>{ui.tagline}</p>
          <p class="foot-note"><Icon name="heart" size={16} /> {ui.footerNote}</p>
        </div>
        {nav.length > 0 && (
          <div>
            <p class="foot-h">{ui.footerSections}</p>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
        )}
        <div>
          <p class="foot-h">{ui.footerAbout}</p>
          <ul>
            <li><a href={authorPath(lang)}>{ui.authorLink}</a></li>
          </ul>
          <p class="foot-langs">{switcher.map(([l, p]) => <a href={p} hreflang={l} lang={l}>{LANG_NAMES[l]}</a>)}</p>
        </div>
      </div>
    </footer>
    <Analytics lang={lang} />
    <script is:inline>
      // [data-print="table"|"sheet"] prints only that part of the page
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-print]');
        if (!b) return;
        document.body.setAttribute('data-printing', b.getAttribute('data-print'));
        window.print();
      });
      window.addEventListener('afterprint', function () { document.body.removeAttribute('data-printing'); });
    </script>
  </body>
</html>
