---
import '@fontsource-variable/nunito/wght.css';
import Analytics from '../components/Analytics.astro';
import Icon from '../components/Icon.astro';
import Related from '../components/Related.astro';
import Logo from '../components/Logo.astro';
import '../styles/global.css';
import '../styles/tools.css';
import '../styles/sheet.css';
import { SITE_NAME } from '../data/site.js';
import { LANG_NAMES, OG_LOCALE, LIVE, NAV, TABBAR, sectionOf, t } from '../i18n/ui.js';
import { HOME } from '../data/home.js';
import { authorPath } from '../data/author.js';
import { LEGAL, legalPath } from '../data/legal.js';

interface Props {
  lang: string;               // 'es' | 'de' | 'it'
  title: string;
  description: string;
  alternates?: Record<string, string>; // hreflang → path of the same page in other languages
  xDefault?: string;          // path for hreflang x-default (the language picker)
  noindex?: boolean;
  crumbs?: { name: string; path: string }[]; // breadcrumb trail after the language home
  jsonLd?: Record<string, unknown>[];
  kidsPage?: boolean;         // child-directed page: ads only with TFAT (later); GA4 runs with Google signals/ad personalization off site-wide (CLAUDE.md allows this)
}

const { lang, title, description, alternates = {}, xDefault = '/', noindex = false, kidsPage = false, crumbs = [], jsonLd = [] } = Astro.props;
const ui = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;
const branded = `${title} | ${SITE_NAME}`;
const fullTitle = branded.length > 65 ? title : branded;
const home = `/${lang}/`;
const section = sectionOf(Astro.url.pathname);
const nav = NAV[lang] ?? [];
const tabs = TABBAR[lang] ?? [];
const groups = HOME[lang]?.groups ?? [];
const current = Astro.url.pathname;
const legalLike = /\/(privacidad|aviso-legal|contacto|datenschutz|impressum|kontakt|privacy|note-legali|contatti|sobre-nosotros|ueber-uns|chi-siamo)\//.test(current);
const showRelated = lang === 'es' && current !== home && !legalLike;
// hreflang only when the page really exists in more than one language
const multi = Object.keys(alternates).length > 1;
const switcher = LIVE.map((l) => [l, alternates[l] ?? `/${l}/`]);
const trail = crumbs.length ? [{ name: ui.home, path: home }, ...crumbs] : [];
const schemas = [...jsonLd];
if (trail.length) schemas.push({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: absolute(c.path) })),
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8f0" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {multi && Object.entries(alternates).map(([l, p]) => <link rel="alternate" hreflang={l} href={absolute(p)} />)}
    {multi && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
  </head>
  <body data-kids={kidsPage ? '1' : undefined} data-section={section}>
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={home} aria-label={`${SITE_NAME}, ${ui.home}`}>
          <Logo />
        </a>
        {nav.length > 0 && (
          <nav class="mainnav" aria-label={ui.menu}>
            {nav.map((n) => <a href={n.href} data-c={n.key} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        )}
        {switcher.length > 1 && <nav class="langs" aria-label={ui.language}>
          {switcher.map(([l, p]) => (
            <a href={p} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>}
      </div>
    </header>
    {tabs.length > 0 && (
      <nav class="tabbar" aria-label={ui.menu}>
          {tabs.map((x) => <a href={x.href} style={`--c: var(--c-${x.key === 'home' ? 'pop' : x.key})`} aria-current={(x.key === 'home' ? current === x.href : current.startsWith(x.href)) ? 'page' : undefined}><i><Icon name={x.icon} size={22} /></i><span>{x.label}</span></a>)}
          <button type="button" data-sheet-open aria-expanded="false" aria-controls="topic-sheet" style="--c: var(--c-juegos)"><i class="dots"><b></b><b></b><b></b></i><span>{TABBAR.more[lang]}</span></button>
        </nav>
    )}
    <main id="main" class="wrap">
      {section !== 'home' && (
        <svg class="deco" viewBox="0 0 220 140" aria-hidden="true">
          <text x="18" y="52" font-size="46" transform="rotate(-12 30 40)">×</text>
          <text x="96" y="40" font-size="34" transform="rotate(10 100 30)">÷</text>
          <text x="160" y="70" font-size="40" transform="rotate(-6 170 60)">%</text>
          <text x="60" y="112" font-size="30" transform="rotate(8 70 100)">½</text>
          <text x="140" y="128" font-size="36" transform="rotate(-14 150 118)">+</text>
          <circle cx="200" cy="20" r="6" /><circle cx="8" cy="100" r="4" />
        </svg>
      )}
      {trail.length > 0 && (
        <nav class="crumbs" aria-label="breadcrumb">
          {trail.map((c, i) => i < trail.length - 1 ? <><a href={c.path}>{c.name}</a><span aria-hidden="true"> › </span></> : <span aria-current="page">{c.name}</span>)}
        </nav>
      )}
      <slot />
      {showRelated && <Related lang={lang} path={current} title="Te puede servir" />}
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <a class="brand" href={home}><Logo dark size={34} /></a>
          <p>{ui.tagline}</p>
          <p class="foot-note"><Icon name="heart" size={16} /> {ui.footerNote}</p>
        </div>
        {nav.length > 0 && (
          <div>
            <p class="foot-h">{ui.footerSections}</p>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
        )}
        <div>
          <p class="foot-h">{ui.footerAbout}</p>
          <ul>
            <li><a href={authorPath(lang)}>{ui.authorLink}</a></li>
            {LEGAL[lang] && (['contact', 'privacy', 'legal'] as const).map((k) => <li><a href={legalPath(lang, k)}>{LEGAL[lang].names[k]}</a></li>)}
            <li><button type="button" class="footer-button" data-open-consent hidden>{LEGAL[lang]?.names.cookies ?? 'Cookies'}</button></li>
          </ul>
          {switcher.length > 1 && <p class="foot-langs">{switcher.map(([l, p]) => <a href={p} hreflang={l} lang={l}>{LANG_NAMES[l]}</a>)}</p>}
        </div>
      </div>
    </footer>
    {tabs.length > 0 && (
      <>

        <div class="tsheet" id="topic-sheet" hidden>
          <div class="tsheet-panel" role="dialog" aria-modal="true" aria-label={TABBAR.allTopics[lang]}>
            <div class="tsheet-head"><strong>{TABBAR.allTopics[lang]}</strong><button type="button" data-sheet-close aria-label={TABBAR.close[lang]}><Icon name="close" size={24} /></button></div>
            {groups.map((g) => (
              <section style={`--c: var(--c-${g.c})`}>
                <h3><span class="tsheet-ic"><Icon name={g.icon} size={18} /></span>{g.title}</h3>
                <ul>{g.links.filter(([, h]) => g.c !== 'tablas' || !/tabla-del-/.test(h)).map(([l, h]) => <li><a href={h} aria-current={current === h ? 'page' : undefined}>{l}</a></li>)}</ul>
                {g.c === 'tablas' && lang === 'es' && <ul class="tsheet-nums">{Array.from({ length: 12 }, (_, i) => i + 1).map((n) => <li><a href={`/es/tablas-de-multiplicar/tabla-del-${n}/`} aria-current={current === `/es/tablas-de-multiplicar/tabla-del-${n}/` ? 'page' : undefined}>×{n}</a></li>)}</ul>}
              </section>
            ))}
            <section style="--c: var(--c-fichas)"><h3><span class="tsheet-ic"><Icon name="sheet" size={18} /></span>Fichas</h3><ul><li><a href="/es/fichas/">Generador de fichas</a></li></ul></section>
          </div>
        </div>
        <script is:inline>
          (function () {
            var sheet = document.getElementById('topic-sheet'), open = document.querySelector('[data-sheet-open]');
            if (!sheet || !open) return;
            var bar = document.querySelector('.tabbar');
            function set(v) { if (v) sheet.style.setProperty('--top', bar.getBoundingClientRect().bottom + 'px'); sheet.hidden = !v; open.setAttribute('aria-expanded', String(v)); document.documentElement.style.overflow = v ? 'hidden' : ''; }
            open.addEventListener('click', function () { set(sheet.hidden); });
            sheet.addEventListener('click', function (e) { if (e.target === sheet || e.target.closest('[data-sheet-close]')) set(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
          })();
        </script>
      </>
    )}
    <Analytics lang={lang} />
    <script is:inline>
      // [data-print="name"] prints only the matching [data-print-area="name"] (and its answers page)
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-print]');
        if (!b) return;
        var name = b.getAttribute('data-print');
        var target = document.querySelector('[data-print-area="' + name + '"]');
        if (!target) return;
        var main = document.getElementById('main');
        var hidden = [];
        (function hide(parent) {
          Array.prototype.forEach.call(parent.children, function (el) {
            if (el === target) return;
            if (el.contains(target)) { hide(el); return; }
            el.classList.add('np'); hidden.push(el);
          });
        })(main);
        document.body.setAttribute('data-printing', name);
        var restore = function () { hidden.forEach(function (el) { el.classList.remove('np'); }); document.body.removeAttribute('data-printing'); window.removeEventListener('afterprint', restore); };
        window.addEventListener('afterprint', restore);
        window.print();
      });
    </script>
  </body>
</html>
