{
  // Static site on Cloudflare Workers (static assets). Build: npm run build → dist/
  // Preview only (workers_dev) until the user says "да" to launch on geniopop.com.
  // At launch: routes [{ pattern: "geniopop.com", custom_domain: true }], workers_dev false, preview_urls false.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geniopop",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true
}
