{
  // Static site on Cloudflare Workers (static assets). Build: npm run build → dist/
  // Production on geniopop.com (launch 2026-11-26 after the user's "запускаем"). Built from GitHub by Workers Builds.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geniopop",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "geniopop.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
